rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (request.auth != null && (
        request.auth.token.email == "imamarifin55@admin.smp.belajar.id" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Connection test collection
    match /test/{docId} {
      allow read: if true;
    }

    // School Profile Info
    match /school_info/{infoId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachers
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Students
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements & News
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity Photos
    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    // Morning Activities (Kegiatan Pagi)
    match /kegiatan_pagi/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    // PPDB Applicants
    match /ppdb_applicants/{applicantId} {
      allow read: if true;
      allow create: if isValidId(applicantId);
      allow update, delete: if true;
    }
  }
}
